# NestJS Server Configuration
PORT=4000
NODE_ENV=development

# PostgreSQL / Supabase Database Connection
# You can provide either a single DATABASE_URL or individual DB_* variables.
# 
# Supabase Connection String Format:
# Session Pooler (port 5432 - recommended for TypeORM / general connections):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# 
# Transaction Pooler (port 6543):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# 
# Direct Connection (port 5432):
# DATABASE_URL=postgresql://postgres:[YOUR_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres.your_project_ref:your_database_password@aws-0-region.pooler.supabase.com:5432/postgres

# Alternatively, configure individual parameters:
DB_HOST=aws-0-region.pooler.supabase.com
DB_PORT=5432
DB_USERNAME=postgres.your_project_ref
DB_PASSWORD=your_database_password
DB_NAME=postgres
DB_SSL=true
