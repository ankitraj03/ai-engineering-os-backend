{
  "name": "ai-engineering-os-backend",
  "version": "1.0.0",
  "description": "AI Engineering OS - Node.js + Express Backend",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "node dist/server.js",
    "start:dev": "ts-node -r tsconfig-paths/register src/server.ts",
    "start:prod": "node dist/server.js",
    "test": "ts-node -r tsconfig-paths/register tests/verify-parity.ts",
    "test:parity": "ts-node -r tsconfig-paths/register tests/verify-parity.ts",
    "test:legacy": "ts-node -r tsconfig-paths/register test/verify-architecture.ts",
    "lint": "eslint \"{src,apps,libs,tests}/**/*.ts\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "pg": "^8.13.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.2"
  }
}
